trufflehog.json
/out/

# Artifacts the evidence pipeline and its quickstart create. Scan output
# can contain the very thing a scan exists to find, so none of it is
# committed by a copy-paste of the README.
results.json
results.*.json
*.v3.json
audit.pre.json
results-hdfv2.json
results-heimdall.json
